# DISABLED 2026-09-02 — renamed out of .yml so GitHub Actions ignores it entirely
# (no push trigger, no manual dispatch, doesn't show up in the Actions tab).
#
# This workflow and build-debug-apk.yml both uploaded an artifact literally named
# `zad-debug-apk` on every push to main, so picking a run in the Actions UI could
# silently hand you a build from either one. That collision was directly responsible
# for real confusion about whether a fix had "actually reached the device": this
# workflow ran assembleDebug with no test/lint gate, no --no-daemon, and (until
# 2026-09-01) with a placeholder Supabase URL that made login impossible. Everything
# it did that build-debug-apk.yml didn't — the google-services.json restore step —
# has been migrated there. build-debug-apk.yml is now the single source of the
# zad-debug-apk artifact. Rename this file back to .yml only if you deliberately need
# a second parallel build workflow, and remove the artifact-name collision if you do.
name: Build Android APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'

    - name: Restore google-services.json
      run: |
        echo "${{ secrets.GOOGLE_SERVICES_JSON_BASE64 }}" | base64 -d > app/google-services.json

    # هذه الخطوة كانت غايبة تماماً — bug حقيقي اكتشفناه 2026-09-01 بعد بلاغ فشل تسجيل
    # دخول كامل. الـ Secrets Gradle Plugin (app/build.gradle.kts's propertiesFileName
    # = ".env"، defaultPropertiesFileName = ".env.example") بيرجع لقيم .env.example
    # الوهمية (SUPABASE_URL=https://your-project-ref.supabase.co،
    # SUPABASE_ANON_KEY=your-anon-key) لو .env مش موجود أو ناقص المفتاحين دول. الـ
    # workflow ده كان بيبني assembleDebug من غير أي .env خالص، فكل APK طالع منه فيه
    # رابط سوبابيز وهمي — تسجيل الدخول كان مستحيل ينجح لأي حساب، مش مشكلة بيانات
    # العميل. نفس الخطوة بالظبط الموجودة في build-debug-apk.yml (اللي هي الصح).
    - name: Write .env
      run: |
        echo "GEMINI_API_KEY=unused" >> .env
        echo "SUPABASE_URL=${SUPABASE_URL}" >> .env
        echo "SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}" >> .env
      env:
        SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
        SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}

    - name: Grant execute permission for gradlew
      run: chmod +x gradlew

    - name: Build with Gradle
      run: ./gradlew assembleDebug

    - name: Upload APK
      uses: actions/upload-artifact@v4
      with:
        name: zad-debug-apk
        path: app/build/outputs/apk/debug/app-debug.apk
