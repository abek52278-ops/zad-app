<?xml version="1.0" encoding="utf-8"?>
<!--
  قاعدة الأمان: بيانات زاد المالية (قاعدة البيانات المشفرة + مفتاحها + كل
  SharedPreferences) **عمرها ما تتنقل** للـ cloud backup أو نقل جهاز —
  لأن مفتاح التشفير محلي، ولو الداتا سافرت من غير المفتاح هتبقى عديمة
  الفايدة، ولو المفتاح سافر معاها يبقى التشفير شكلي.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="zad_database"/>
        <exclude domain="sharedpref" path="zad_db_key.xml"/>
        <exclude domain="sharedpref" path="zad_consumption.xml"/>
        <exclude domain="sharedpref" path="zad_bank_reading_status.xml"/>
        <exclude domain="sharedpref" path="zad_voice_persona.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="zad_database"/>
        <exclude domain="sharedpref" path="zad_db_key.xml"/>
        <exclude domain="sharedpref" path="zad_consumption.xml"/>
        <exclude domain="sharedpref" path="zad_bank_reading_status.xml"/>
        <exclude domain="sharedpref" path="zad_voice_persona.xml"/>
    </device-transfer>
</data-extraction-rules>
