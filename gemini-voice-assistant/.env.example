# Gemini API Key with Multimodal Live API access
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Live API (Default: gemini-2.0-flash-exp or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Voice Config: Puck, Charon, Kore, Fenrir, Aoede
GEMINI_VOICE=Puck

# Server Port
PORT=8080

# MCP Server Configs (Optional: path to stdio MCP servers)
# SQLITE_DB_PATH=./data/tasks.db
